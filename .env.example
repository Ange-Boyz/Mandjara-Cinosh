# Public build-time configuration. NEVER put secrets here: every VITE_* value
# is embedded in the browser bundle and visible to anyone.

# Base URL of the Mandjara API (HTTPS only in production). Leave empty in
# development to use the built-in mock backend.
VITE_API_BASE_URL=

# Set to "true" to force the mock backend (development / demos only).
# The mock is NEVER used in a production build unless this is explicitly true.
VITE_USE_MOCK=

# Public contact details shown on the site.
VITE_CONTACT_EMAIL=mandjara777@gmail.com
